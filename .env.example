# رابط قاعدة بيانات MongoDB (من MongoDB Atlas أو أي مزوّد)
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/gdg_portal?retryWrites=true&w=majority

# مفتاح توقيع الجلسات (JWT) — ضع نصاً عشوائياً طويلاً وسرّياً
JWT_SECRET=change_me_to_a_long_random_secret

# منفذ تشغيل الـ API محلياً (اختياري)
PORT=5000
